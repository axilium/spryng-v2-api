{
    "name": "axilium/spryng-v2-api",
    "description": "Zero-dependency PHP client for the Spryng Messaging v2 API",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "spryng",
        "sms",
        "messaging",
        "api-client"
    ],
    "authors": [
        {
            "name": "Raymond Steffann",
            "email": "raymond@axilium.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Axilium\\SpryngV2\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Axilium\\SpryngV2\\Tests\\": "tests/"
        }
    },
    "archive": {
        "exclude": [
            "/.docksal",
            "/.editorconfig",
            "/.env",
            "/.env.example",
            "/.gitattributes",
            "/.github",
            "/.idea",
            "/.phpunit.cache",
            "/CLAUDE.md",
            "/docs",
            "/phpunit.xml.dist",
            "/tests",
            "/tools",
            "/vendor"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
