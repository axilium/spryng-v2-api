# Docksal environment for this package.
#
# CLI-only: no web server, no database. The package is a library, so all we
# need is a PHP runtime with composer.
DOCKSAL_STACK=""

# PHP 8.1 is the supported floor. Override per shell to test a newer runtime:
#   CLI_IMAGE=docksal/cli:php8.3-3.8 fin project restart
CLI_IMAGE="docksal/cli:php8.1-3.8"

XDEBUG_ENABLED=0
